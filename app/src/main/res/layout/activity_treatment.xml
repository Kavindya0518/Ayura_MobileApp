<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@color/earth_brown"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/todo"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:text="@string/ayurvedic_treatments"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#BFB7B4"
        android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <!-- Treatment Card Example -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="4dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:radius="8dp">

            <!-- Treatment Image -->

            <!-- Treatment Details -->
            <ImageView
                android:id="@+id/imgTreatment1"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/treatment_image"
                android:scaleType="centerCrop"
                android:src="@drawable/img_41" />

            <LinearLayout
                android:layout_marginStart="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTreatmentName1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/beheth_oruwa"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000000"/>

                <TextView
                    android:id="@+id/tvForm1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/form_herbal_decoction_boiled_herbs_in_water"
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:paddingTop="4dp"/>

                <TextView
                    android:id="@+id/tvUse1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:text="@string/use_taken_orally_for_detoxification_boosting_immunity_and_treating_ailments"
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="4dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:radius="8dp">

            <!-- Treatment Image -->
            <ImageView
                android:id="@+id/imgTreatment"
                android:layout_width="80dp"
                android:layout_height="120dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/treatment_image"
                android:scaleType="centerCrop"
                android:src="@drawable/img_48" />

            <!-- Treatment Details -->
            <LinearLayout
                android:layout_marginStart="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTreatmentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lepa_thailapoth"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000000"/>

                <TextView
                    android:id="@+id/tvForm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/form_herbal_paste_or_oil"
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:paddingTop="4dp"/>

                <TextView
                    android:id="@+id/tvUse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:text="@string/use_applied_externally_for_skin_issues_inflammation_or_wounds"
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="4dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:radius="8dp">

            <!-- Treatment Image -->
            <ImageView
                android:id="@+id/imgTreatment3"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/treatment_image"
                android:scaleType="centerCrop"
                android:src="@drawable/img_45" />

            <!-- Treatment Details -->
            <LinearLayout
                android:layout_marginStart="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTreatmentName3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sweda_steam_therapy"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000000"/>

                <TextView
                    android:id="@+id/tvForm3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/form_herbal_steam_applied_to_the_body"
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:paddingTop="4dp"/>

                <TextView
                    android:id="@+id/tvUse3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:text="@string/use_reduces_stiffness_relieves_muscle_joint_pain_and_promotes_detoxification_through_sweating"
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="4dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:radius="8dp">

            <!-- Treatment Image -->
            <ImageView
                android:id="@+id/imgTreatment4"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/treatment_image"
                android:scaleType="centerCrop"
                android:src="@drawable/img_46" />

            <!-- Treatment Details -->
            <LinearLayout
                android:layout_marginStart="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTreatmentName4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/abhyanga_thaila_abhyanga"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000000"/>

                <TextView
                    android:id="@+id/tvForm4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/form_full_body_oil_massage_using_medicinal_oils"
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:paddingTop="4dp"/>

                <TextView
                    android:id="@+id/tvUse4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:text="@string/use_relieves_stress_improves_circulation_nourishes_skin_and_strengthens_joints_and_muscles"
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="4dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:radius="8dp">

            <!-- Treatment Image -->
            <ImageView
                android:id="@+id/imgTreatment5"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/treatment_image"
                android:scaleType="centerCrop"
                android:src="@drawable/img_47" />

            <!-- Treatment Details -->
            <LinearLayout
                android:layout_marginStart="18dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTreatmentName5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kizhi_pottu"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000000"/>

                <TextView
                    android:id="@+id/tvForm5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/form_herbal_poultice_or_bolus_applied_externally"
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:paddingTop="4dp"/>

                <TextView
                    android:id="@+id/tvUse5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:text="@string/use_for_joint_pain_swelling_or_skin_conditions"
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="4dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:radius="8dp">

            <!-- Treatment Image -->
            <ImageView
                android:id="@+id/imgTreatment2"
                android:layout_width="80dp"
                android:layout_height="120dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/treatment_image"
                android:scaleType="centerCrop"
                android:src="@drawable/img_44" />

            <!-- Treatment Details -->
            <LinearLayout
                android:layout_marginStart="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTreatmentName2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/panchakarma"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000000"/>

                <TextView
                    android:id="@+id/tvForm2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/form_series_of_five_purification_therapies_includes_therapies_like_vamana_emesis_virechana_purgation_basti_medicated_enema_nasya_nasal_therapy_raktamokshana_bloodletting"
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:paddingTop="4dp"/>

                <TextView
                    android:id="@+id/tvUse2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:text="@string/use_detoxification_balancing_doshas_improving_digestion_and_rejuvenation"
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>



    </LinearLayout>

</ScrollView>

    <LinearLayout
        android:id="@+id/footerLayout"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:gravity="center"
        android:elevation="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Home -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_background_selected"
                android:contentDescription="@string/todo"
                android:padding="10dp"
                android:src="@drawable/ic_home"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Products -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnProducts"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/todo"
                android:padding="10dp"
                android:background="@null"
                app:tint="#7B3F00"
                android:src="@drawable/ic_products" />

        </LinearLayout>

        <!-- Plants -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btnPlants"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/todo"
                android:src="@drawable/ic_plant"
                android:background="@null"
                app:tint="#7B3F00"
                android:padding="10dp"/>
        </LinearLayout>

        <!-- Doctor -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnDoctor"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/todo"
                android:background="@null"
                android:padding="10dp"
                android:src="@drawable/doctor"
                app:tint="#7B3F00" />
        </LinearLayout>

        <!-- Profile -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnProfile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@null"
                android:contentDescription="@string/todo"
                android:padding="10dp"
                android:src="@drawable/ic_profile"
                app:tint="#7B3F00" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>