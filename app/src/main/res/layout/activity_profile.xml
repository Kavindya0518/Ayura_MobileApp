                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#EEEEEE">


                <LinearLayout
