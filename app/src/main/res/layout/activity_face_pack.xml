<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDE7E3">

    <!-- Product Image -->

    <!-- Back Button -->

    <!-- Favorite Button -->

    <ImageView
        android:id="@+id/productImage"
        android:layout_width="match_parent"
        android:layout_height="555dp"
        android:layout_above="@+id/productDetailsCard"
        android:layout_alignParentTop="true"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="-40dp"
        android:contentDescription="@string/todo"
        android:scaleType="centerCrop"
        android:src="@drawable/img_34" />

    <ImageButton
        android:id="@+id/btnBack2"
        android:layout_width="62dp"
        android:layout_height="60dp"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/todo"
        android:src="@drawable/ic_back"
        app:tint="@color/white" />

    <ImageButton
        android:id="@+id/btnFavorite"
        android:layout_width="63dp"
        android:layout_height="59dp"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="16dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/todo"
        android:src="@drawable/outline_favorite_24"
        app:tint="@color/white" />

    <!-- Bottom Card -->
    <LinearLayout
        android:id="@+id/productDetailsCard"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_above="@+id/footer"
        android:background="@drawable/rounded_top_white"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Product Name -->
        <TextView
            android:id="@+id/productName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/turmeric_face_pack"
            android:textColor="#000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Price -->
        <TextView
            android:id="@+id/productPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/lkr_750"
            android:textColor="#2E7D32"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Short Description -->
        <TextView
            android:id="@+id/productDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/a_natural_skincare_solution_that_brightens_skin_fights_blemishes_and_gives_a_healthy_glow"
            android:textColor="#555"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Quantity Selector + Add to Cart -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Quantity Controls -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnMinus"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/circle_bg_light"
                    android:contentDescription="@string/decrease"
                    android:src="@drawable/outline_check_indeterminate_small_24" />

                <TextView
                    android:id="@+id/tvQuantity"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="@string/_1"
                    android:textColor="#000"
                    android:textSize="18sp" />

                <ImageButton
                    android:id="@+id/btnPlus"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/circle_bg_light"
                    android:backgroundTint="#D5B49C"
                    android:contentDescription="@string/increase"
                    android:src="@drawable/plus_svgrepo_com" />

            </LinearLayout>

            <!-- Spacer -->
            <View
                android:layout_width="16dp"
                android:layout_height="0dp" />

            <!-- Add to Cart Button -->
            <Button
                android:id="@+id/btnAddToCart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/earth_brown"
                android:text="@string/add_to_cart"
                android:textColor="#FFF"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Footer Navigation -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:background="@color/white"
        android:gravity="center">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@null"
                android:contentDescription="@string/todo"
                android:padding="10dp"
                android:src="@drawable/ic_home"
                app:tint="#7B3F00" />
        </LinearLayout>

        <!-- Products -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnProducts"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_background_selected"
                android:contentDescription="@string/todo"
                android:padding="10dp"
                android:src="@drawable/ic_products"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Plants -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btnPlants"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/todo"
                android:src="@drawable/ic_plant"
                android:background="@null"
                app:tint="#7B3F00"
                android:padding="10dp"/>
        </LinearLayout>

        <!-- Doctor -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnDoctor"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/todo"
                android:background="@null"
                android:padding="10dp"
                android:src="@drawable/doctor"
                app:tint="#7B3F00" />
        </LinearLayout>

        <!-- Profile -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnProfile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@null"
                android:contentDescription="@string/todo"
                android:padding="10dp"
                android:src="@drawable/ic_profile"
                app:tint="#7B3F00" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
